# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
monolith-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache and generated static copies.
/priv/static/cache_manifest.json
/priv/static/**/*-????????????????????????????????.*
/priv/static/**/*.gz

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Database files
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Local credentials and environment files (only the secret-free template is public).
.env
.env.*
!.env.example
# dotenvx private decryption keys must never be committed, even with encrypted .env.
.env.keys
/secrets/

# Stage-designer output and refresh metadata (private local data).
/data/stage-designer/
.DS_Store

# Explicitly built local macOS Keychain helper.
/priv/native/*-keychain
/priv/native/*-vault

# Dedicated credential vaults, migration journals and private rollback copies.
*.vault/
*.encrypted*
*.plaintext*
*.keychain
*.keychain-db

