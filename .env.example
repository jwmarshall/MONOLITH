# LOVELACE — public, credential-free template. Never put real secrets in this file.
# See docs/STAGE_DESIGNER.md for encrypted local setup with dotenvx.
# Generation is opt-in and runs once per eligible application startup, never per page load.

# Google OAuth client for read-only Gmail (macOS-first). See docs/GMAIL.md.
# Store real values only through your private encrypted dotenvx workflow.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Gemini Developer API key is entered in Connections and stored in macOS Keychain.
# GEMINI_API_KEY is no longer read; there is no environment fallback.

# Enable locally only when ready for paid generation; tests force startup generation off.
LOVELACE_STAGE_ENABLED=false
LOVELACE_STAGE_MODEL=gemini-nano-banana-2.1
LOVELACE_STAGE_ASPECT_RATIO=16:9
LOVELACE_STAGE_IMAGE_SIZE=1K

# Automatic curation on application-process startup, not page loads or reconnects.
# Attempt timestamps persist in SQLite, including failed/uncertain outcomes (24h minimum).
LOVELACE_STAGE_REFRESH=on_startup
LOVELACE_STAGE_MIN_REFRESH_HOURS=24
LOVELACE_STAGE_MAX_ATTEMPTS_PER_STARTUP=1
LOVELACE_STAGE_MAX_RETRIES=0
LOVELACE_STAGE_TIMEOUT_SECONDS=120

# Private, persistent local output; not a public static directory or a remote URL.
# Relative to the application working directory; use an absolute path for releases.
LOVELACE_STAGE_STORAGE_DIR=./data/stage-designer

# Intentional actions reset the timer; mouse movement does not count or wake the pane.
LOVELACE_WORKSPACE_IDLE_MINUTES=3

# Generic art direction only. Never include mailbox data or personal information.
LOVELACE_STAGE_PROMPT="Create a quiet cinematic architectural landscape for a personal desktop workspace. Original minimalist brutalist architecture, distant expansive scenery, charcoal planes, restrained warm amber light, subtle atmospheric depth, deliberate negative space, and a calm low-detail center. Vary the architecture, terrain, weather, and time of day within this visual language. No people, text, lettering, logos, watermarks added by the prompt, busy foregrounds, neon cyberpunk, or interface elements."
