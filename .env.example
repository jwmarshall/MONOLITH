# MONOLITH — public, credential-free template. Never put real secrets in this file.
# See docs/STAGE_DESIGNER.md for non-secret scenery configuration.
# Paid startup generation waits for the first ordinary unlock.

# Google OAuth client credentials: mix monolith.google.configure (hidden terminal input).
# Gemini API key: Connections. Both use the dedicated password-unlocked MONOLITH keychain.
# No runtime environment fallback for integration secrets.

# GitHub App client ID, secret and slug: Connections → GitHub.
# Stored only in the dedicated password-unlocked MONOLITH keychain; no env fallback.

# Enable locally only when ready for paid generation; tests force startup generation off.
MONOLITH_STAGE_ENABLED=false
MONOLITH_STAGE_MODEL=gemini-nano-banana-2.1
MONOLITH_STAGE_ASPECT_RATIO=16:9
MONOLITH_STAGE_IMAGE_SIZE=1K

# Automatic curation on first ordinary unlock per application startup, not page loads/re-unlocks.
# Attempt timestamps persist in SQLite, including failed/uncertain outcomes (24h minimum).
MONOLITH_STAGE_REFRESH=on_startup
MONOLITH_STAGE_MIN_REFRESH_HOURS=24
MONOLITH_STAGE_MAX_ATTEMPTS_PER_STARTUP=1
MONOLITH_STAGE_MAX_RETRIES=0
MONOLITH_STAGE_TIMEOUT_SECONDS=120

# Private, persistent local output; not a public static directory or a remote URL.
# Relative to the application working directory; use an absolute path for releases.
MONOLITH_STAGE_STORAGE_DIR=./data/stage-designer

# Intentional actions reset the timer; mouse movement does not count or wake the pane.
MONOLITH_WORKSPACE_IDLE_MINUTES=3

# Generic art direction only. Never include mailbox data or personal information.
MONOLITH_STAGE_PROMPT="Create a quiet cinematic architectural landscape for a personal desktop workspace. Original minimalist brutalist architecture, distant expansive scenery, charcoal planes, restrained warm amber light, subtle atmospheric depth, deliberate negative space, and a calm low-detail center. Vary the architecture, terrain, weather, and time of day within this visual language. No people, text, lettering, logos, watermarks added by the prompt, busy foregrounds, neon cyberpunk, or interface elements."
